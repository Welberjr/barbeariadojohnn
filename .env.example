# ===========================================
# BARBEARIA DO JOHNN - Environment Variables
# ===========================================
# Renomeie para .env.local e preencha com os valores reais

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SEU_ANON_KEY_AQUI
SUPABASE_SERVICE_ROLE_KEY=SEU_SERVICE_ROLE_KEY_AQUI

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Barbearia do Johnn"

# Mercado Pago (preenchido depois)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Assinatura secreta mostrada em Mercado Pago > Suas integrações > Webhooks.
MP_WEBHOOK_SECRET=

# Cron (obrigatório em produção)
# O cron de lembretes falha FECHADO: sem este segredo configurado na Vercel,
# /api/cron/reminders recusa tudo e nenhum lembrete sai. Use um valor aleatório
# longo e cadastre o mesmo valor no header do agendador.
CRON_SECRET=

# Anthropic (preenchido depois)
ANTHROPIC_API_KEY=

# Meta WhatsApp (preenchido depois)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WEBHOOK_VERIFY_TOKEN=
# App Secret da aplicação Meta. Sem ele, eventos recebidos são recusados.
META_APP_SECRET=
